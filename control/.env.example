# Control page settings. install.sh creates control/.env from this (mode 600).
# Don't edit the two secrets by hand: use ./control/set-password.sh.

# Hostname the page is served on (same as proxy/.env).
PUBLIC_HOSTNAME=
# Password hash, base64-encoded (set by ./control/set-password.sh).
CONTROL_PASSWORD_HASH=
# Signs session cookies. Changing it signs everyone out (set-password.sh does).
CONTROL_SECRET_KEY=

# Optional: validator key check (Validator card → Check deposits / Check status). Public values.
# Validator public key(s), 0x + 96 hex characters, comma-separated (the pubkey field of deposit_data-*.json).
VALIDATOR_PUBKEYS=
# The withdrawal address the credentials must pay to (0x01). Blank = compare with the validator's fee recipient.
VALIDATOR_WITHDRAWAL_ADDRESS=
