    {
      "id": 6,
      "type": "stat",
      "title": "Since last attestation",
      "description": "Slots between the beacon head and the validator's newest attestation (10 s each). Under 64 (two epochs) is normal; the alert fires above 128.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "scalar(max(pulse_cl_head_slot)) - max(validator_last_attested_slot)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: slots",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 64
              },
              {
                "color": "red",
                "value": 128
              }
            ]
          },
          "decimals": 0,
          "noValue": "-"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Slashing protection refusals",
      "description": "Signatures the slashing-protection DB refused since the client started. Anything above 0 means another copy of these keys is running, or the DB is an old copy.",
