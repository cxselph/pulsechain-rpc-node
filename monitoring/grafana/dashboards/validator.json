        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(up{job=\"validator\"})",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Running",
                  "color": "green"
                },
                "0": {
                  "text": "Not running",
                  "color": "text"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Status",
      "description": "What the beacon chain says about the validator. Deposited / Pending: waiting for activation (can take days). Active: attesting. Exiting, Slashing or Exited: see the alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(validator_statuses)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unknown",
                  "color": "text"
                },
                "1": {
                  "text": "Deposited",
                  "color": "blue"
                },
                "2": {
                  "text": "Pending",
                  "color": "blue"
                },
                "3": {
                  "text": "Active",
                  "color": "green"
                },
                "4": {
                  "text": "Exiting",
                  "color": "orange"
                },
                "5": {
                  "text": "Slashing",
                  "color": "red"
                },
                "6": {
                  "text": "Exited",
                  "color": "text"
                },
                "7": {
                  "text": "Invalid",
                  "color": "red"
                },
                "8": {
                  "text": "Partially deposited",
                  "color": "orange"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "No keys running"
        },
        "overrides": []
      }
    },
