# Monitoring settings. Copy to monitoring/.env (install.sh does this) and fill in.
# monitoring/.env holds secrets: it is gitignored and install.sh makes it mode 600.

# --- Alert email (Grafana SMTP) ---------------------------------------------
# Works with any SMTP provider. SMTP2GO example: create a dedicated SMTP user
# for this node in SMTP2GO, so it can be revoked on its own.
GF_SMTP_ENABLED=true
GF_SMTP_HOST=mail.smtp2go.com:587
GF_SMTP_STARTTLS_POLICY=MandatoryStartTLS
GF_SMTP_USER=
GF_SMTP_PASSWORD=
# Must be an address/domain your SMTP provider has verified.
GF_SMTP_FROM_ADDRESS=
GF_SMTP_FROM_NAME=PulseChain node

# Where alerts are sent (comma-separated for several).
ALERT_EMAIL_TO=

# --- Grafana URL ------------------------------------------------------------
# Before the HTTPS front end: reach Grafana through an SSH tunnel at
#   http://localhost:3000/grafana/   (leave these two as they are)
# After the HTTPS front end: GRAFANA_ROOT_URL=https://<your-host>/grafana/ and
# GRAFANA_COOKIE_SECURE=true, then ./monitoring/restart.sh
GRAFANA_ROOT_URL=http://localhost:3000/grafana/
GRAFANA_COOKIE_SECURE=false

# --- Prometheus ---------------------------------------------------------------
# How long metrics history is kept (stored under $DATA_DIR/monitoring/prometheus).
# At least 45d so the 30-day validator readiness window is always complete.
PROMETHEUS_RETENTION=45d
