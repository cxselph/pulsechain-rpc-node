# validator/.env — settings for the optional validator client
# Copy to validator/.env:  cp validator/.env.example validator/.env
# This file is gitignored. It holds no secrets (addresses are public).

# Where block tips go. Required: Prysm's default is the zero address, which burns them.
# Use an address you control (for example your hardware wallet). It can be changed
# later: edit this line, then sudo ./validator/restart.sh.
FEE_RECIPIENT=

# Optional text in blocks you propose (max 32 bytes).
# VALIDATOR_GRAFFITI=

# Metrics port on 127.0.0.1 (Prometheus scrapes it).
# VALIDATOR_METRICS_PORT=8081
